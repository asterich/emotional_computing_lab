# Qwen / DashScope OpenAI-compatible endpoint.
# The pipeline also reads .envrc if direnv has not exported these variables.
export QWEN_API_KEY="sk-..."
export QWEN_API_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
export QWEN_MODEL="qwen-vl-plus"

# Optional aliases also supported:
# export DASHSCOPE_API_KEY="sk-..."
# export DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
